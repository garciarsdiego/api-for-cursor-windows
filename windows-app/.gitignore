# Dependencies
node_modules/

# Frontend build output
dist/

# Rust / Tauri build output
src-tauri/target/

# Generated Tauri schema/ACL files
src-tauri/gen/schemas/

# Bundled sidecar binaries (produced by `bun build --compile` in CI)
src-tauri/binaries/*.exe

# SDK bridge runtime resources (regenerated in CI: node runtime, copied script, deps).
# Only src-tauri/bridge/package.json is committed.
src-tauri/bridge/node.exe
src-tauri/bridge/bun.exe
src-tauri/bridge/cursor-sdk-local-agent-bridge.mjs
src-tauri/bridge/bun.lock
src-tauri/bridge/bun.lockb
src-tauri/bridge/package-lock.json

# Tauri updater signing keys (must never be committed)
*.key
*.key.pub
